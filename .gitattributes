* text=auto eol=lf
*.md text eol=lf
*.tex text eol=lf
*.py text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.pdf binary
*.zip binary
*.png binary
*.jpg binary

# Preserve byte identities of archived evidence and reservation receipts.
archives/** -text
publication/audit/** -text
publication/zenodo/*.json -text

# Compiler transcripts are verbatim evidence, including their whitespace.
preprints/**/compiler_logs/** -text -whitespace

# Paper III documents and evidence retain their audited byte identities.
preprints/PAPER_III/** -text
scripts/verify_cdr_iii.py -text
scripts/verify_package.py -text
